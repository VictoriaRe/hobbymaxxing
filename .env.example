# Server-only YouTube Data API v3 key. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Device subscriptions and test pushes require Supabase and VAPID.
# Keep all values except the VAPID public key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed after an external scheduling service is configured.
CRON_SECRET=
# Set to true after applying supabase/notifications.sql and verifying test
# delivery on a real device. This does not enable scheduled reminders.
PUSH_NOTIFICATIONS_ENABLED=false
# Keep false until a suitable external scheduler is configured and verified.
SCHEDULED_PUSH_NOTIFICATIONS_ENABLED=false
