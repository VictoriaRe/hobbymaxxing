# Server-only YouTube Data API v3 key. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Push requires Supabase, VAPID, and the authenticated scheduled job.
# Keep all values except the VAPID public key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Change to true only after applying supabase/notifications.sql, deploying the
# cron schedule, and verifying delivery on a real device.
PUSH_NOTIFICATIONS_ENABLED=false
